# Neon Postgres (vercel integration add neon)
DATABASE_URL=

# Auth.js
AUTH_SECRET=              # openssl rand -base64 32
AUTH_TWITTER_ID=          # X OAuth 2.0 client id
AUTH_TWITTER_SECRET=      # X OAuth 2.0 client secret

# Optional reaction gifs
GIPHY_API_KEY=
TENOR_API_KEY=

# Comma-separated X handles exempt from the follower/age rule (founder, testers)
ELIGIBILITY_EXEMPT=

# Comma-separated X handles allowed into /inspector (manual moderation)
ADMIN_HANDLES=

# Google Analytics 4 measurement id (G-XXXXXXXXXX). Optional.
PUBLIC_GA_ID=

# Canonical host for 301s from other hosts (set once DNS is live). Optional.
CANONICAL_HOST=

# Vercel Cron auth for /api/cron/backup
CRON_SECRET=

# @shitdotso bot (OAuth 2.0 user tokens; refresh needs the client secret)
X_BOT_CLIENT_ID=
X_BOT_CLIENT_SECRET=
X_BOT_ACCESS_TOKEN=
X_BOT_REFRESH_TOKEN=
